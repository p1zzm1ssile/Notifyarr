# Copy to .env and fill in. Leave a channel blank to disable it.

TZ=Europe/London

# --- Telegram: create a bot with @BotFather, send it a message, then open
#     https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=info

# --- Email (Gmail: smtp.gmail.com, 587, starttls, with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_MIN_SEVERITY=warning

# --- CrowdSec (only if [crowdsec] enabled = true):  cscli bouncers add notifyarr
CROWDSEC_BOUNCER_KEY=

# --- Web GUI (LAN only). Leave empty to turn the GUI off. At least 10 characters.
GUI_PASSWORD=
GUI_PORT=8484
